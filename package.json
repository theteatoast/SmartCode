{
  "name": "smartcode-runtime",
  "version": "1.0.0",
  "description": "Terminal-first optimization runtime for AI coding agents. Makes Claude Code and OpenCode sessions more efficient with real-time loop detection, response compression, and session analytics.",
  "main": "dist/index.js",
  "bin": {
    "smartcode": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "postinstall": "node -e \"try{require('node-pty')}catch(e){console.error('\\n⚠️  node-pty failed to load. You may need build tools:\\n  Windows: npm install -g windows-build-tools\\n  macOS: xcode-select --install\\n  Linux: sudo apt install build-essential\\n');process.exit(1)}\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theteatoast/SmartCode.git"
  },
  "keywords": [
    "ai",
    "coding",
    "claude",
    "opencode",
    "optimization",
    "terminal",
    "cli",
    "loop-detection",
    "developer-tools"
  ],
  "author": "theteatoast",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/theteatoast/SmartCode/issues"
  },
  "homepage": "https://github.com/theteatoast/SmartCode#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "better-sqlite3": "^12.10.0",
    "commander": "^14.0.3",
    "node-pty": "^1.1.0",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
